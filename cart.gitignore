.env.local
.env.development.local
.env.test.local
.env.production.local

# Системні файли (macOS та Windows)
.DS_Store
Thumbs.db
desktop.ini

# Налаштування редакторів коду (якщо не хочете ділитися своїми темами чи конфігами)
