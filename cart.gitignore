# Залежності та пакети (якщо використовуєте npm/yarn)
node_modules/
jspm_packages/
web_modules/

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Папки збірки та дистрибутивів (якщо використовуєте webpack, vite, gulp тощо)
dist/
build/
.out/
.next/

# Секретні ключі та змінні оточення (налаштування API, доступи)
